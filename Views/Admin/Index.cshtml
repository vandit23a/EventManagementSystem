@{
    ViewData["Title"] = "Admin Dashboard";

    var eventParticipation = ViewBag.EventParticipation;
}

<div class="container mt-4">

    <h1>Admin Dashboard</h1>

    <p class="text-muted">
        Welcome, @User.Identity?.Name
    </p>

    <hr />

    <!-- Summary -->
    <div class="row mb-4">

        <div class="col-md-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>

                    <h2>
                        @ViewBag.TotalEvents
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Participants</h5>

                    <h2>
                        @ViewBag.TotalParticipants
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Admin Management -->
    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <h5 class="card-title mb-1">
                    Admin Management
                </h5>

                <p class="text-muted mb-0">
                    Create and manage administrator accounts.
                </p>
            </div>

            <a asp-controller="AdminManagement"
               asp-action="Index"
               class="btn btn-primary">
                Manage Admins
            </a>



        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-6">
                    <h4 class="card-title mb-2">
                        Student Management
                    </h4>

                    <p class="text-muted mb-0">
                        View and manage student accounts.
                    </p>
                </div>

                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <a asp-controller="StudentManagement"
                       asp-action="Index"
                       class="btn btn-info">
                        Manage Students
                    </a>
                </div>

            </div>

        </div>
    </div>

    <!-- Event Participation -->
    <div class="card">

        <div class="card-header">
            <h4 class="mb-0">
                Event Participation
            </h4>
        </div>

        <div class="card-body">

            @if (eventParticipation != null && eventParticipation.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Maximum Seats</th>
                                <th>Participants</th>
                                <th>Vacant Seats</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in eventParticipation)
                            {
                                var vacantSeats =
                                    Math.Max(
                                        0,
                                        item.MaxParticipants - item.Participants
                                    );

                                <tr>

                                    <td>
                                        @item.EventName
                                    </td>

                                    <td>
                                        @item.MaxParticipants
                                    </td>

                                    <td>
                                        @item.Participants
                                    </td>

                                    <td>
                                        @vacantSeats
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted">
                    No events are available.
                </p>
            }

        </div>

    </div>

</div>