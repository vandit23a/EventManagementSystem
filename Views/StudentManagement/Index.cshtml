@model IEnumerable<EventManagementSystem.Data.ApplicationUser>

@{
    ViewData["Title"] = "Manage Students";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Manage Students</h1>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No student accounts are available.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int studentNumber = 1;
                    }

                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>
                                @studentNumber
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(student.Name)
                                    ? "Name not available"
                                    : student.Name)
                            </td>

                            <td>
                                @student.Email
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(student.PhoneNumber)
                                    ? "Not provided"
                                    : student.PhoneNumber)
                            </td>

                            <td>
                                <form asp-controller="StudentManagement"
                                      asp-action="Delete"
                                      asp-route-id="@student.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this student account?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>

                        studentNumber++;
                    }

                </tbody>

            </table>

        </div>
    }

</div>