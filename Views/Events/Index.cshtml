@model IEnumerable<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Events</h1>

        <div class="card mb-4">
            <div class="card-body">

                <h4 class="mb-3">Search & Filter Events</h4>

                <form asp-controller="Events"
                      asp-action="Index"
                      method="get">

                    <div class="row">

                        <!-- Event Name -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Event Name
                            </label>

                            <input type="text"
                                   name="searchName"
                                   value="@ViewBag.SearchName"
                                   class="form-control"
                                   placeholder="Search event..." />
                        </div>

                        <!-- Category -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Category
                            </label>

                            <select name="category"
                                    class="form-select">

                                <option value="">
                                    All Categories
                                </option>

                                @foreach (var item in ViewBag.Categories)
                                {
                                    if (ViewBag.Category == item)
                                    {
                                        <option value="@item" selected>
                                            @item
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@item">
                                            @item
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                        <!-- Date -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Date
                            </label>

                            <input type="date"
                                   name="date"
                                   value="@ViewBag.Date"
                                   class="form-control" />
                        </div>

                        <!-- Upcoming -->
                        <div class="col-md-3 mb-3">

                            <label class="form-label d-block">
                                Event Type
                            </label>

                            <div class="form-check mb-3">
    <input class="form-check-input"
           type="checkbox"
           name="upcomingOnly"
           value="true"
           id="upcomingOnly"
           @(ViewBag.UpcomingOnly == true ? "checked" : "") />

    <label class="form-check-label" for="upcomingOnly">
        Upcoming Events Only
    </label>
</div>

                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </form>

            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                Create New Event
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No events are available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Venue</th>
                        <th>Max Participants</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Category</td>
                            <td>@item.Date.ToString("dd-MM-yyyy")</td>
                            <td>@item.Time.ToString(@"hh\:mm")</td>
                            <td>@item.Venue</td>
                            <td>@item.MaxParticipants</td>
                            <td>@item.Status</td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.EventId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.EventId"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>