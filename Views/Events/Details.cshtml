@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">

    <h1>Event Details</h1> 

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <hr />

    <div class="card">
        <div class="card-body">

            <h3 class="card-title">@Model.Name</h3>

            <p>
                <strong>Description:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Category:</strong>
                @Model.Category
            </p>

            <p>
                <strong>Date:</strong>
                @Model.Date.ToString("dd-MM-yyyy")
            </p>

            <p>
                <strong>Time:</strong>
                @Model.Time.ToString(@"hh\:mm")
            </p>

            <p>
                <strong>Venue:</strong>
                @Model.Venue
            </p>

            <p>
                <strong>Maximum Participants:</strong>
                @Model.MaxParticipants
            </p>

            <p>
                <strong>Participated:</strong>
                @ViewBag.ParticipatedSeats
            </p>

            <p>
                <strong>Vacant Seats:</strong>
                @ViewBag.VacantSeats
            </p>

            

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

        </div>
    </div>

    <div class="mt-3">

        @if (User.IsInRole("Student"))
{
    @if (Model.Status != "Completed" && Model.Status != "Cancelled")
    {
        @if (ViewBag.IsRegistered == true)
        {
            <a asp-action="CancelRegistration"
               asp-route-id="@Model.EventId"
               class="btn btn-danger"
               onclick="return confirm('Are you sure you want to cancel your registration?');">
                Cancel Registration
            </a>
        }
        else
        {
            <a asp-action="Register"
               asp-route-id="@Model.EventId"
               class="btn btn-success">
                Register for Event
            </a>
        }
    }
}

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.EventId"
               class="btn btn-warning">
                Edit
            </a>
        }

        <a asp-action="Participants"
           asp-route-id="@Model.EventId"
           class="btn btn-info">
            View Participants
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Events
        </a>

    </div>

</div>