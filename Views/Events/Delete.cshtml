@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">

    <h1>Delete Event</h1>

    <div class="alert alert-danger">
        Are you sure you want to delete this event?
    </div>

    <div class="card">
        <div class="card-body">

            <h3>@Model.Name</h3>

            <p>
                <strong>Category:</strong>
                @Model.Category
            </p>

            <p>
                <strong>Date:</strong>
                @Model.Date.ToString("dd-MM-yyyy")
            </p>

            <p>
                <strong>Time:</strong>
                @Model.Time.ToString(@"hh\:mm")
            </p>

            <p>
                <strong>Venue:</strong>
                @Model.Venue
            </p>

            <p>
                <strong>Maximum Participants:</strong>
                @Model.MaxParticipants
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

        </div>
    </div>

    <div class="mt-3">

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="EventId" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Event
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>