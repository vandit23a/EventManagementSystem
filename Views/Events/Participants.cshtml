@model IEnumerable<EventManagementSystem.Models.EventRegistration>

@{
    ViewData["Title"] = "Event Participants";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Event Participants</h1>

            <p class="text-muted mb-0">
                Event: <strong>@ViewBag.EventName</strong>
            </p>
        </div>

        <div>
            <span class="badge bg-primary fs-6">
                Total Participants: @ViewBag.ParticipantCount
            </span>
        </div>
    </div>

    <hr />

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student Name</th>
                        <th>Registration Date</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int participantNumber = 1;
                    }

                    @foreach (var participant in Model)
                    {
                        <tr>
                            <td>
                                @participantNumber
                            </td>

                            <td>
                                @participant.StudentName
                            </td>

                            <td>
                                @participant.RegistrationDate.ToString("dd-MM-yyyy")
                            </td>
                        </tr>

                        participantNumber++;
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No students have registered for this event yet.
        </div>
    }

    <div class="mt-3">

        <a asp-action="Details"
           asp-route-id="@ViewBag.EventId"
           class="btn btn-secondary">
            Back to Event Details
        </a>

    </div>

</div>